# Copie este arquivo para .env e ajuste os valores.
# NUNCA suba o .env de verdade pro GitHub (ele já está no .gitignore).

SECRET_KEY=troque-por-uma-chave-secreta-gerada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Produção (Render + Supabase) =====

# Banco: em Project Settings > Database no Supabase, use a "Connection
# string" no modo "Session pooler" (porta 6543) — funciona melhor com o
# Render do que a conexão direta.
# DATABASE_URL=postgres://usuario:senha@host:6543/postgres

# Domínio(s) reais da aplicação em produção (sem http/https, sem barra final):
# ALLOWED_HOSTS=corretora-de-milhoes.onrender.com,www.seudominio.com.br
# CSRF_TRUSTED_ORIGINS=https://corretora-de-milhoes.onrender.com,https://www.seudominio.com.br

# Fotos dos imóveis: em Storage no Supabase, crie um bucket público e gere
# credenciais S3 em Storage > S3 Connection. Sem essas variáveis, o projeto
# continua salvando as fotos localmente (só serve para desenvolvimento —
# no Render o disco é apagado a cada deploy).
# SUPABASE_STORAGE_BUCKET=nome-do-bucket
# SUPABASE_STORAGE_ENDPOINT_URL=https://<ref-do-projeto>.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_ACCESS_KEY=...
# SUPABASE_STORAGE_SECRET_KEY=...
# SUPABASE_STORAGE_REGION=us-east-1
